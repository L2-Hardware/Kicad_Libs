         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">AR0235CS - 1/2.8-inch 2 MP CMOS Digital Image Sensor with Global Shutter</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The AR0235CS is a 1/2.8-inch CMOS digital image sensor with an&#xD;&#xA;active-pixel array of 1920 (H) x 1200 (V).</rdf:li>
            </rdf:Alt>
         </dc:description>
