         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">NCV8161 - LDO Regulator - Ultra-Low Noise, High PSRR, RF and Analog Circuits  450 mA</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The NCV8161 is a linear regulator capable of supplying 450â€‰mA output current. Designed to meet the requirements of RF and analog circuits, the NCV8161 device provides low noise, high PSRR, low quiescent current, and very good load/line transients.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:c45e1879-4724-4072-ab08-ef55851cccf9</xmpMM:DocumentID>
