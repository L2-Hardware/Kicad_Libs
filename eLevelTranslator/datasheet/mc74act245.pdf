         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MC74AC245 - Octal Bidirectional Transceiver with 3 State Inputs/Outputs</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ON Semiconductor</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The MC74AC245/74ACT245 contains eight nonâˆ’inverting&#xD;&#xA;bidirectional buffers with 3âˆ’state outputs and is intended for&#xD;&#xA;busâˆ’oriented applications. Current sinking capability is 24 mA at both&#xD;&#xA;the A and B ports. The Transmit/Receive (T/R) input determines the&#xD;&#xA;direction of data flow through the bidirectional transceiver. Transmit&#xD;&#xA;(activeâˆ’HIGH) enables data from A ports to B ports; Receive&#xD;&#xA;(activeâˆ’LOW) enables data from B ports to A ports. The Output&#xD;&#xA;Enable input, when HIGH, disables both A and B ports by placing&#xD;&#xA;them in a High Z condition.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:2520a8a0-8b0c-479c-a1c8-fb0a71995016</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:5727dac1-3e1c-432e-81dd-047607a835bd</xmpMM:InstanceID>
         <illustrator:StartupProfile>Print</illustrator:StartupProfile>
      </rdf:Description>
   </rdf:RDF>
